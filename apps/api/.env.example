# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgres://skyops:skyops@localhost:5433/skyops

# --- Application ---
# development or production
NODE_ENV=development
# Port the API listens on
PORT=3001
# Prefix for all API routes (e.g. /api/drones)
API_PREFIX=api

# --- Maintenance policy ---
# A drone is due for maintenance whichever comes first:
# this many days since the last maintenance, or this many flight hours.
MAINTENANCE_INTERVAL_DAYS=90
MAINTENANCE_INTERVAL_FLIGHT_HOURS=50
# Tolerance (in hours) when validating the flight-hours reading at maintenance time.
MAINTENANCE_TOLERANCE_HOURS=1